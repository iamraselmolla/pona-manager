generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum CompanyBatchStatus {
  pending    // payment made, waiting for pona
  delivered  // pona received, mir entry done
}

enum PonaType {
  Golda
  Bagda
  Vannamei
}
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String   @unique
  password  String
  role      String   @default("staff")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id               String   @id @default(cuid())
  name             String
  mobile           String   @unique
  address          String?
  area             String?
  totalOrders      Int      @default(0)
  totalPLPurchased Float    @default(0)
  totalPaid        Float    @default(0)
  totalDue         Float    @default(0)
  hasRunningOrder  Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  orders   Order[]
  payments Payment[]
  notes    CustomerNote[]
}

model Order {
  id              String   @id @default(cuid())
  customerId      String?
  customerName    String
  customerMobile  String
  customerAddress String?
  ponaType        String
  plQuantity      Float
  unitRate        Float
  totalPrice      Float
  advanceAmount   Float    @default(0)
  dueAmount       Float    @default(0)
  deliveryDate    String
  status          String   @default("pending")
  batchId         String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer    Customer?    @relation(fields: [customerId], references: [id])
  batch       Batch?       @relation(fields: [batchId], references: [id])
  batchOrders BatchOrder[]
  payments    Payment[]
}

model Batch {
  id                     String    @id @default(cuid())
  batchNumber            String    @unique
  batchDate              String
  status                 String    @default("pending")
  totalOrderedGolda      Float     @default(0)
  totalDeliveredGolda    Float     @default(0)
  totalOrderedBagda      Float     @default(0)
  totalDeliveredBagda    Float     @default(0)
  totalOrderedVannamei   Float     @default(0)
  totalDeliveredVannamei Float     @default(0)
  totalCollected         Float     @default(0)
  totalDue               Float     @default(0)
  totalExpenses          Float     @default(0)
  totalProfit            Float     @default(0)
  pendingDeliveries      Int       @default(0)
  duePendingCount        Int       @default(0)
  completedAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  batchOrders BatchOrder[]
  expenses    BatchExpense[]
  orders      Order[]
    companyOrders  CompanyOrder[]

}

model BatchOrder {
  id                String    @id @default(cuid())
  batchId           String
  orderId           String
  companyOrderId    String?   // Link to company order
  deliveryStatus    String    @default("pending")
  deliveredQuantity Float?
  deliveryRate      Float?
  finalAmount       Float?
  customerPayment   Float?
  dueAmount         Float?
  duePaymentDate    String?
  notes             String?
  deliveredAt       DateTime?
  
  // Mir fields
  companyMir        Float?
  ourMir            Float?
  mirDiff           Float?
  totalPoly         Float?
  totalFish         Float?    // ourMir × totalPoly
  deliveredPL       Float?
  discount          Float?
  isPartial         Boolean   @default(false)
  remainingQuantity Float     @default(0)
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  batch        Batch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  order        Order         @relation(fields: [orderId], references: [id])
  companyOrder CompanyOrder? @relation(fields: [companyOrderId], references: [id])
}

model BatchExpense {
  id      String @id @default(cuid())
  batchId String
  label   String
  amount  Float

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)
}

model Payment {
  id         String   @id @default(cuid())
  customerId String
  orderId    String
  amount     Float
  date       String
  notes      String?
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
  order    Order    @relation(fields: [orderId], references: [id])
}

model Expense {
 id        String   @id @default(cuid())
  amount    Float
  category  String
  date      String
  notes     String?
  batchId   String?
  createdAt DateTime @default(now())
}

model DailyClosing {
  id               String   @id @default(cuid())
  date             String   @unique
  totalOrders      Int      @default(0)
  totalDeliveries  Int      @default(0)
  totalSales       Float    @default(0)
  totalCollections Float    @default(0)
  totalDue         Float    @default(0)
  totalExpenses    Float    @default(0)
  totalCompanyMir  Float    @default(0)
  totalCountingMir Float    @default(0)
  transportExpense Float    @default(0)
  laborExpense     Float    @default(0)
  otherExpenses    Float    @default(0)
  netProfitLoss    Float    @default(0)
  cashInHand       Float    @default(0)
  closedAt         DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  content    String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
}


model CompanyOrder {
  id              String              @id @default(cuid())
  
  // Payment info (created when we pay company)
  ponaType        String              // Golda, Bagda, Vannamei
  paymentAmount   Float               // how much we paid
  ratePerPL       Float               // price per PL (e.g. 4tk)
  expectedPL      Float               // paymentAmount / ratePerPL
  expectedDate    DateTime            // expected delivery date
  status          String              @default("pending") // pending | delivered
  notes           String?

  // Filled after pona arrives
  mirValue        Float?              // company mir (e.g. 1150)
  totalPoly       Float?              // how many poly bags received
  totalPL         Float?              // mirValue × totalPoly
  actualAmount    Float?              // totalPL × ratePerPL
  paidToCompany   Float?              // what we actually paid on delivery
  dueToCompany    Float?              // actualAmount - paymentAmount - paidToCompany
  advanceToUs     Float?              // if we overpaid

  // Carry forward from previous CompanyOrder
  prevDue         Float               @default(0)
  prevAdvance     Float               @default(0)
  netDue          Float               @default(0)
  netAdvance      Float               @default(0)

  // Link to delivery batch
  batchId         String?             // set when pona is assigned to a batch
  
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  batch           Batch?              @relation(fields: [batchId], references: [id])
  batchOrders     BatchOrder[]        // Orders delivered for this company order
}
